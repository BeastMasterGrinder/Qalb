# ──────────────────────────────────────────────────────────────────────────────
# Supabase
# Get these from https://app.supabase.com/project/_/settings/api
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key (used in utils/supabase/auth.ts).
# NEVER expose this to the client.
NEXT_PRIVATE_SUPABASE_SERVICE_KEY=your-service-role-key

# ──────────────────────────────────────────────────────────────────────────────
# App / deployment
# ──────────────────────────────────────────────────────────────────────────────
# Bare hostname only — the app prefixes it with https:// (and sometimes www.)
# in sitemap.ts, robots.ts, layouts, and the auth callback URL.
# Example: qalb.example.com   (NOT https://qalb.example.com)
NEXT_PUBLIC_APP_URL=your-bare-hostname

# ──────────────────────────────────────────────────────────────────────────────
# Stripe (donations)
# Used in lib/payments/stripe.ts for checkout sessions.
# ──────────────────────────────────────────────────────────────────────────────
NEXT_STRIPE_SECRET_KEY_TEST=sk_test_...

# ──────────────────────────────────────────────────────────────────────────────
# Analytics
# ──────────────────────────────────────────────────────────────────────────────
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Optional — analytics
# is skipped entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# PostHog (client-side product analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ──────────────────────────────────────────────────────────────────────────────
# External services
# ──────────────────────────────────────────────────────────────────────────────
# Token used to authenticate against the blog content API (app/api/blogs).
BLOG_API_TOKEN=your-blog-api-token

# API key for the sentiment-analysis ML service (lib/actions/getSentiments.ts).
NEXT_ML_SERVICE_API_KEY=your-ml-service-api-key

# Base URL for the Qalb microservice that ServicePinger pings.
QALB_MICRO_SERVICE=https://your-microservice-url
